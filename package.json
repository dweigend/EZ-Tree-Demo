{
  "name": "ez-tree-infinite-landscape",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:all": "bun run assets:atlas",
    "assets:atlas": "bun run scripts/build-terrain-atlas.ts",
    "assets:patina": "bun run scripts/generate-patina-materials.ts",
    "assets:references": "python3 \"${CODEX_HOME:-$HOME/.codex}/skills/.system/imagegen/scripts/image_gen.py\" generate-batch --input assets/source/terrain-materials/prompts.jsonl --out-dir assets/source/terrain-materials/references --model gpt-image-2 --size 1024x1024 --quality medium --concurrency 3 --no-augment",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "bun test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@fal-ai/client": "^1.10.1",
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
